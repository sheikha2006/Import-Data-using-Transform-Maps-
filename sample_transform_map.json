{
  "name": "Employee CSV -> User Transform",
  "source": "employee_import.csv",
  "target_table": "sys_user",
  "coalesce": ["u_employee_id"],
  "field_mappings": {
    "employee_id": "u_employee_id",
    "first_name": "first_name",
    "last_name": "last_name",
    "email": "email",
    "department": "u_department",
    "active": "active"
  },
  "script_file": "transform_map_script.js"
}
